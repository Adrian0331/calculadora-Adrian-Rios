@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html>
<head>
    <title>Operaciones</title>

    <style>
            body {
                font-family: Arial;
                text-align: center;
                background-color: #f2f2f2;
            }

            .calculadora {
                width: 350px;
                margin: 100px auto;
                padding: 20px;
                background-color: white;
                border-radius: 10px;
            }

            input {
                width: 90%;
                padding: 10px;
                margin: 5px;
            }

            button 1 {
                padding: 10px;
                margin: 5px;
                border: none;
                border-radius: 5px;
                background-color: #9DE3E3;
                color: black;
                cursor: pointer;
            }

            button 2 {
                padding: 10px;
                margin: 5px;
                border: none;
                border-radius: 5px;
                background-color: #9DE3E6;
                color: black;
                cursor: pointer;
            }

            button:hover {
                background-color: #555;
            }

            #resultado {
                font-size: 20px;
                margin-top: 20px;
            }
    </style>
</head>

<body>

    <div class="calculadora">

        <h2><C>Calculadora</C></h2>

        <input type="number" id="numero1" placeholder="Primer número">

        <input type="number" id="numero2" placeholder="Segundo número">

        <br>

        <button onclick="suma()">Suma</button>
        <button onclick="resta()">Resta</button>
        <button onclick="multiplicacion()">Multiplicación</button>
        <button onclick="division()">División</button>

        <p id="resultado">Resultado: </p>

    </div>


    <script>

            function suma() {
                let numero1 = Number(document.getElementById("numero1").value);
                let numero2 = Number(document.getElementById("numero2").value);

                let resultado = numero1 + numero2;

                document.getElementById("resultado").innerHTML = "Resultado: " + resultado;
            }

            function resta() {
                let numero1 = Number(document.getElementById("numero1").value);
                let numero2 = Number(document.getElementById("numero2").value);

                let resultado = numero1 - numero2;

                document.getElementById("resultado").innerHTML = "Resultado: " + resultado;
            }

            function multiplicacion() {
                let numero1 = Number(document.getElementById("numero1").value);
                let numero2 = Number(document.getElementById("numero2").value);

                let resultado = numero1 * numero2;

                document.getElementById("resultado").innerHTML = "Resultado: " + resultado;
            }

            function division() {
                let numero1 = Number(document.getElementById("numero1").value);
                let numero2 = Number(document.getElementById("numero2").value);

                let resultado = numero1 / numero2;

                document.getElementById("resultado").innerHTML = "Resultado: " + resultado;
            }

    </script>

</body>
</html>
